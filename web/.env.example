# BirgenAI Movies - Environment Variables
# Copy this file to .env.local and fill in your values

# ====================================
# BACKEND API
# ====================================
# Preferred: route all API calls through the Cloudflare Worker edge cache.
# The Worker strips /api, forwards to Cloud Run, and caches hot paths — this
# is what kills the 429s you saw before.
NEXT_PUBLIC_API_PROXY_URL=https://birgenai.com/api

# Fallback (or override during local dev): direct Cloud Run URL.
# NEXT_PUBLIC_API_URL=https://birgenai-api-529186868469.us-central1.run.app

# ====================================
# SUPABASE (Auth + Database + RLS)
# Create a project at https://supabase.com and copy the values from
# Project Settings → API.
# ====================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New-style publishable key (sb_publishable_…) or legacy anon JWT — both
# accepted by @supabase/ssr and @supabase/supabase-js.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Server-only: used by Next.js route handlers / server actions / Cloudflare
# Workers. NEVER prefix with NEXT_PUBLIC_ and never reference it from a
# client component. In Vercel, set this WITHOUT the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ====================================
# SCREEN-TIME PAYWALL (free tier cap)
# Defaults: 20h/month cap, 16h warning threshold.
# ====================================
NEXT_PUBLIC_FREE_TIER_CAP_SECONDS=72000
NEXT_PUBLIC_WARN_THRESHOLD_SECONDS=57600

# ====================================
# TMDB API (Movie Posters & Metadata)
# Get your FREE key at: https://www.themoviedb.org/settings/api
# ====================================
# API Key (v3 auth) - used as query param fallback
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# API Read Access Token (v4 auth) - preferred, used as Bearer token (server-side)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# ====================================
# CLOUDFLARE R2 — Static Assets (Videos & Images)
# Videos are too large for Vercel's static file limits.
# Upload them to Cloudflare R2 and set the public URL below.
# Leave empty for local development (serves from public/ folder).
# ====================================
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.birgenai.com

# ====================================
# CLOUDFLARE STREAM — Full Movie Streaming (Optional)
# Only needed if you've uploaded movies to Cloudflare Stream.
# ====================================
NEXT_PUBLIC_CF_STREAM_DOMAIN=customer-XXXXX.cloudflarestream.com
