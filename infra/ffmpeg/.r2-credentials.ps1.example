# Copy this file to ".r2-credentials.ps1" (same folder) and fill in the values
# from your Cloudflare R2 API token (S3 credentials). That real file is
# git-ignored, so your keys never get committed.
#
# Create the token at:  Cloudflare dashboard -> R2 -> "Manage R2 API Tokens"
#   -> Create API token -> Permission: "Object Read & Write"
#   -> (optionally scope to the "birgenai-assets" bucket)
# Copy the "Access Key ID" and "Secret Access Key" it shows you ONCE.

$R2_ACCESS_KEY_ID     = 'PASTE_ACCESS_KEY_ID_HERE'
$R2_SECRET_ACCESS_KEY = 'PASTE_SECRET_ACCESS_KEY_HERE'

# Your Cloudflare account ID (the upload script already defaults to it; only set
# this if your account differs).
$R2_ACCOUNT_ID        = 'PASTE_ACCOUNT_ID_HERE'

# S3 endpoint for reference (rclone builds this from the account id above):
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
